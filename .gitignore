# Environment files (allow .env.example)
.env
.env.*
!.env.example
api/.env
api/.env.*
!api/.env.example
web/.env
web/.env.*
!web/.env.example

# Dependencies
/vendor
vendor/
api/vendor/
/node_modules
node_modules/
web/node_modules/

# Build artifacts & distributions
/dist
dist/
web/dist/
/public/build
public/build/
api/public/build/
api/public/storage

# Storage, cache, sessions, logs
/storage/*.key
api/storage/*.key
api/storage/app/*
!api/storage/app/.gitignore
!api/storage/app/public/
api/storage/app/public/*
!api/storage/app/public/.gitignore
api/storage/framework/cache/*
!api/storage/framework/cache/.gitignore
api/storage/framework/cache/data/*
!api/storage/framework/cache/data/.gitignore
api/storage/framework/sessions/*
!api/storage/framework/sessions/.gitignore
api/storage/framework/views/*
!api/storage/framework/views/.gitignore
api/storage/logs/*
!api/storage/logs/.gitignore
*.log
api/storage/logs/*.log

# Audio, video, media uploads & recordings
*.mp3
*.wav
*.m4a
*.mp4
*.webm
*.ogg
api/storage/app/meetings/**
api/storage/app/private/**

# Database dumps & local databases
*.sql
*.sqlite
*.db

# Test caches & temporary files
.phpunit.result.cache
api/.phpunit.result.cache
.phpunit.cache
.vite/
web/.vite/

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
