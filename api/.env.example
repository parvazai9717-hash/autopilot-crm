APP_NAME="Autopilot CRM"
APP_ENV=local
APP_KEY=base64:CHANGE_ME_run_php_artisan_key_generate
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=https://your-api-domain.example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=autopilot-db
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
QUEUE_CONNECTION=database
CACHE_STORE=file

# Machine Authentication (n8n API Key checked via X-API-Key)
# Rotate in Easypanel; update n8n credential QDpOvRubD545BMZ5 to match.
# Generate with: openssl rand -hex 32
N8N_API_KEY=CHANGE_ME

# Outbound Webhook Target URLs (Per Section 14)
N8N_WEBHOOK_MEETING_UPLOADED=https://your-n8n-domain.example.com/webhook/meeting-ingest
N8N_WEBHOOK_MEETING_NEEDS_REVIEW=https://your-n8n-domain.example.com/webhook/meeting-needs-review
N8N_WEBHOOK_TASKS_APPROVED=https://your-n8n-domain.example.com/webhook/tasks-approved
N8N_WEBHOOK_TASK_COMPLETED=https://your-n8n-domain.example.com/webhook/task-completed
N8N_WEBHOOK_TASK_BLOCKED=https://your-n8n-domain.example.com/webhook/task-blocked

# Outbound Webhook HMAC-SHA256 Signing Secret (sent as X-Autopilot-Signature)
# Generate with: openssl rand -base64 32
WEBHOOK_SIGNING_SECRET=CHANGE_ME

# Inbound Webhook Gateway Secret (Phase 3 — must match n8n autopilot-platform-gateway credential)
# Generate with: openssl rand -hex 32
WEBHOOK_GATEWAY_SECRET=CHANGE_ME

# Audio & Video Processing Paths and Limits (Section 10)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MAX_UPLOAD_MB=500
AUDIO_CHUNK_MAX_MB=24

# How long a meeting may sit in `processing` before it is considered stuck (minutes)
MEETING_PROCESSING_TIMEOUT=30

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
